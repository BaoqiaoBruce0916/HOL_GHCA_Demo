---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const [categories, publishers, games] = await Promise.all([
    getAllCategories(getDatabase()),
    getAllPublishers(getDatabase()),
    getAllGames(getDatabase()),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700/70 bg-slate-800/50 p-5 shadow-lg shadow-slate-950/30">
      <form data-testid="game-filters-form" class="space-y-4">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end">
          <fieldset class="flex-1" aria-label="Filter games by category">
            <legend class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-slate-300">Categories</legend>
            <div class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-5">
              {categories.map((category) => (
                <label
                  for={`category-${category.id}`}
                  class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 transition hover:border-blue-500/60 hover:bg-slate-800 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
                >
                  <input
                    id={`category-${category.id}`}
                    name="category"
                    type="checkbox"
                    value={category.id}
                    class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="min-w-[220px]">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium uppercase tracking-[0.2em] text-slate-300">
              Publisher
            </label>
            <select
              id="publisher-filter"
              name="publisher"
              aria-label="Filter games by publisher"
              class="w-full rounded-lg border border-slate-700 bg-slate-900/70 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </div>

          <div class="flex items-center gap-3">
            <button
              type="submit"
              class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-md shadow-blue-600/20 transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="apply-filters-button"
            >
              Apply filters
            </button>
            <button
              type="button"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-slate-400 hover:bg-slate-700/60 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="clear-filters-link"
            >
              Clear filters
            </button>
          </div>
        </div>
      </form>
    </div>

    <div>
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-300" data-testid="game-results-count" aria-live="polite">
          {games.length} game{games.length === 1 ? '' : 's'} shown
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>

      <div data-testid="empty-state" hidden class="hidden text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700">
        <p data-testid="empty-state-text" class="text-slate-300">No games match the selected filters.</p>
      </div>
    </div>
  </div>

  <script type="module">
    const form = document.querySelector('[data-testid="game-filters-form"]');
    const categoryInputs = Array.from(document.querySelectorAll('input[name="category"]'));
    const publisherSelect = document.querySelector('[data-testid="publisher-filter"]');
    const clearButton = document.querySelector('[data-testid="clear-filters-link"]');
    const cards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));
    const emptyState = document.querySelector('[data-testid="empty-state"]');
    const resultsCounter = document.querySelector('[data-testid="game-results-count"]');

    function updateResults() {
      const selectedCategories = categoryInputs
        .filter((input) => input.checked)
        .map((input) => Number(input.value));
      const selectedPublisherId = publisherSelect && publisherSelect.value ? Number(publisherSelect.value) : null;

      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryId = Number(card.dataset.gameCategoryId || '0');
        const publisherId = Number(card.dataset.gamePublisherId || '0');
        const categoryMatch = selectedCategories.length === 0 || selectedCategories.includes(categoryId);
        const publisherMatch = selectedPublisherId === null || publisherId === selectedPublisherId;
        const isVisible = categoryMatch && publisherMatch;

        card.hidden = !isVisible;
        card.setAttribute('aria-hidden', String(!isVisible));
        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
      }

      const hasActiveFilters = selectedCategories.length > 0 || selectedPublisherId !== null;
      if (resultsCounter) {
        resultsCounter.textContent = `${visibleCount} game${visibleCount === 1 ? '' : 's'} shown${hasActiveFilters ? ' (filtered)' : ''}`;
      }

      const params = new URLSearchParams();
      selectedCategories.forEach((categoryId) => params.append('category', String(categoryId)));
      if (selectedPublisherId !== null) {
        params.set('publisher', String(selectedPublisherId));
      }

      const queryString = params.toString();
      const url = new URL(window.location.href);
      if (queryString) {
        url.search = queryString;
      } else {
        url.search = '';
      }
      window.history.replaceState({}, '', url.toString());
    }

    if (form) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        updateResults();
      });
    }

    categoryInputs.forEach((input) => {
      input.addEventListener('change', updateResults);
    });

    if (publisherSelect) {
      publisherSelect.addEventListener('change', updateResults);
    }

    if (clearButton) {
      clearButton.addEventListener('click', () => {
        categoryInputs.forEach((input) => {
          input.checked = false;
        });
        if (publisherSelect) {
          publisherSelect.value = '';
        }
        updateResults();
      });
    }

    updateResults();
  </script>
</Layout>
